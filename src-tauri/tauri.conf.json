{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobTrack",
  "version": "2.0.0",
  "identifier": "com.jobtrack.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "JobTrack",
      "width": 1280,
      "height": 820,
      "minWidth": 960,
      "minHeight": 650,
      "resizable": true,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": { "wix": { "language": "en-US" } }
  }
}
